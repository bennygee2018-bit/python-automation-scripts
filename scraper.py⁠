import requests
from bs4 import BeautifulSoup
import pandas as pd

url = "http://quotes.toscrape.com/"
response = requests.get(url)
soup = BeautifulSoup(response.text, "html.parser")

data = []
for item in soup.find_all("div", class_="quote"):
    text = item.find("span", class_="text").text
    author = item.find("small", class_="author").text
    data.append({"Quote": text, "Author": author})

df = pd.DataFrame(data)
df.to_excel("extracted_leads_or_data.xlsx", index=False)

print("Automation Complete: Data successfully cleaned and saved to Excel!")
